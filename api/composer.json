{
    "name": "tnc/notarial-api",
    "description": "API REST/JSON de l'etude notariale (Slim 4)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "firebase/php-jwt": "^7.2",
        "monolog/monolog": "^3.9",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.15.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {},
        "platform": {
            "php": "8.4.0",
            "ext-fileinfo": "8.4.0",
            "ext-mbstring": "8.4.0",
            "ext-pdo": "8.4.0",
            "ext-pdo_mysql": "8.4.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "test": "phpunit"
    }
}
