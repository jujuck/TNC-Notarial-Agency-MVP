{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // Accès hors du projet : confirmation
    { "action": "external_directory", "resource": "*", "effect": "deny" },

    // Fichiers secrets : jamais lus ni modifiés (sauf .env.example)
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },

    // Shell : confirmation par défaut
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "git add *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },

    // Lectures sans risque : autorisées
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "openspec *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose ps *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "docker compose logs *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "docker compose config *",
      "effect": "allow",
    },

    // Interdits
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "deny" },
    {
      "action": "shell",
      "resource": "docker compose down *",
      "effect": "ask",
    },
    { "action": "shell", "resource": "docker volume *", "effect": "deny" },
    {
      "action": "shell",
      "resource": "docker system prune *",
      "effect": "deny",
    },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
  ],
}
