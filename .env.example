# Copier ce fichier en .env puis remplacer toutes les valeurs.
# Ne jamais committer .env.

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
HTTP_PORT=8080

# Base MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=notarial
MYSQL_USER=notarial
MYSQL_PASSWORD=change-me-db-password
DB_PORT_HOST=3307

# JWT HS256 : au moins 32 caracteres, genere par exemple avec `openssl rand -base64 48`
JWT_SECRET=change-me-with-at-least-32-characters
JWT_TTL=28800
